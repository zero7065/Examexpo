# ============================================
# ExamPadi AI — Environment Configuration
# ============================================
# Copy this to .env and fill with your actual keys

# ========== FIREBASE (Required for Auth & Database) ==========
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ========== AI TUTOR (Required for question explanations) ==========
# Choose ONE: Gemini OR Groq (Gemini recommended)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here

# ========== PAYMENTS (Required for Pro subscriptions) ==========
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox key starts with pk_test_
# Live key starts with pk_live_

# ========== MONITORING & ANALYTICS (Optional) ==========
# Error tracking with Sentry
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxx.ingest.us.sentry.io/xxxxx

# Analytics tracking (Google Analytics 4)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ========== APP CONFIGURATION ==========
VITE_APP_URL=http://localhost:5173

# ========== INTERNAL: Do NOT share or commit ==========
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx